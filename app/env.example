# Ключи проекта «Автошкола». Файл лежит вне веб-корня, в git не попадает, пересылать нельзя.
# Сервер: /srv/drive/app/.env (chmod 600, владелец www-data)

# --- Google-таблица «Чат-бот» ---
GOOGLE_SHEET_ID=
GOOGLE_KEY_FILE=google-key.json

# --- Подтверждение номера звонком (zvonok.com) ---
ZVONOK_PUBLIC_KEY=
ZVONOK_CAMPAIGN_ID=
ZVONOK_CONFIRM_CAMPAIGN_ID=

# --- Проверка фото ИИ (Yandex AI Studio, агент Qwen3.6-35B) ---
YANDEX_API_KEY=
YANDEX_PROJECT_ID=
YANDEX_PROMPT_ID=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# --- Адреса ---
APP_BASE_URL=https://team.example.com
STUDENT_BASE_URL=https://portal.example.com

# --- Сервер Timeweb Cloud (Ubuntu 26.04, 203.0.113.10) ---
TIMEWEB_API_TOKEN=
SERVER_IP=203.0.113.10

# --- S3 Timeweb (приватный бакет для фото и документов) ---
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Битрикс24 (входящий вебхук, скоупы im, tasks, crm) ---
BITRIX_WEBHOOK=

# --- Учётная система школы (нужен отдельный ключ для портала) ---
SCHOOL_CRM_BASE_URL=https://crm.example.com/api/
SCHOOL_CRM_API_KEY=

# Сборщик отзывов (app/reviews.php)
# REVIEWS_SHEET_ID=
# REVIEWS_FROM=2026-10-01
# отдельный IPv4 сервера, с которого ходим в Zoon, и пауза между филиалами, сек
REVIEWS_ZOON_IP=
REVIEWS_ZOON_PAUSE=180
# резидентный прокси для Zoon: http://логин:пароль@хост:порт (с ним пауза по умолчанию 15 сек)
REVIEWS_ZOON_PROXY=
# ключ Google Places API
GOOGLE_PLACES_KEY=
